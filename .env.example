DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Cloudinary media storage. Only needed locally when you want uploads to go to
# Cloudinary; leave blank and the storage plugin no-ops (uploads fall back to
# local-disk storage).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
